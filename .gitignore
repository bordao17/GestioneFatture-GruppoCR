# =========================
# File di Sistema (OS)
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
# Variabili d'Ambiente e Segreti
# =========================
.env
.env.*
!.env.example

# =========================
# Frontend (React / Vite)
# =========================
frontend/node_modules/
frontend/dist/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# =========================
# Backend (Python / FastAPI)
# =========================
__pycache__/
*.py[cod]
*$py.class
backend/venv/
backend/.venv/
backend/env/
.pytest_cache/

# =========================
# Volumi Docker e Dati Sensibili
# =========================
# Ignoriamo i file dentro le cartelle delle fatture per non intasare la repo, 
# ma manteniamo le cartelle stesse usando un (eventuale) file .gitkeep
#fatture_da_leggere/*
 #!fatture_da_leggere/.gitkeep

#fatture_lette/*
#!fatture_lette/.gitkeep


# Ignoriamo il database locale del backend (se usi SQLite)
!backend/data/.gitkeep
*.sqlite3
*.db
# =========================
# Database delle anagrafiche (Postgres)
# =========================
# I file di Postgres sono stato runtime: centinaia di MB che cambiano a ogni
# scrittura e che non si leggono fuori dal container. La lezione e' n8n_config/,
# 327 MB di sqlite finiti in git. Il contenuto utile dell'anagrafica resta
# leggibile e versionato in backend/data/fornitori_memoria.json, che
# salva_memoria() riscrive a ogni salvataggio come copia di scorta.
postgre/dati/

# =========================
# Uptime Kuma (il guardiano)
# =========================
# Stessa ragione di postgre/dati: qui dentro c'e' un sqlite che cresce a ogni
# battito di ogni monitor, piu' gli screenshot e la cache. La configurazione
# utile (quali monitor esistono e perche') e' scritta in CLAUDE.md.
uptime-kuma/dati/
